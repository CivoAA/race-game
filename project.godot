; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="RoadTycoon"
config/description="2D Top-Down Rennbahn-Baukasten"
config/version="0.9.0"
run/main_scene="res://scenes/Splash.tscn"
config/custom_user_dir_name="RoadTycoon"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.086, 0.098, 0.129, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"
"#Fester,saubererSpeicherortfÃ¼ruser://âwirdvonSteamAuto-Cloudsynchronisiert.#Windows:%APPDATA%\\RoadTycoon\\(statt%APPDATA%\\Godot\\app_userdata\\...)config/use_custom_user_dir"=true

[autoload]

Paths="*res://scripts/Paths.gd"
Localization="*res://scripts/Localization.gd"
Lang="*res://scripts/Lang.gd"
Icons="*res://scripts/Icons.gd"
Economy="*res://scripts/Economy.gd"
RUI="*res://scripts/RUI.gd"
GameHUD="*res://scripts/GameHUD.gd"
GlobalModal="*res://scripts/GlobalModal.gd"
PauseMenu="*res://scripts/PauseMenu.gd"
MusicPlayer="*res://scripts/MusicPlayer.gd"
Display="*res://scripts/Display.gd"
Sfx="*res://scripts/Sfx.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=480
window/size/min_height=270

[gui]

common/snap_controls_to_pixels=false
theme/custom="res://ui_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
